// =============================================================================
// prog_alu.hex — TC 1.1 Machine Code (RV64I)
// =============================================================================
// Format: Verilog $readmemh (32-bit words, one per line, little-endian byte order)
// Memory address: 0x0 (instruction start)
//
// Assembly → Machine Code Encoding:
//   PC    | Instruction      | Machine Code | Notes
//   ────────────────────────────────────────────────────────────────
//   0x00  | addi x2, x0, 1   | 0x00100113   | x2 := 1
//   0x04  | addi x3, x0, 2   | 0x00200193   | x3 := 2
//   0x08  | and x6, x2, x3   | 0x00331333   | x6 := x2 AND x3 = 0
//   0x0C  | or x7, x2, x3    | 0x00331733   | x7 := x2 OR x3 = 3
//   0x10  | xor x8, x2, x3   | 0x00331833   | x8 := x2 XOR x3 = 3
//   0x14  | ecall            | 0x00000073   | TRAP: mcause=11
//   0x18  | j 0x00           | 0xff9ff06f   | Jump back to start (hang)
//
// RVFI Trace (expected commits):
//   [0] commit_instr=0x00100113, commit_pc=0x0000, rd=2, rd_wdata=0x0000000000000001
//   [1] commit_instr=0x00200193, commit_pc=0x0004, rd=3, rd_wdata=0x0000000000000002
//   [2] commit_instr=0x00331333, commit_pc=0x0008, rd=6, rd_wdata=0x0000000000000000
//   [3] commit_instr=0x00331733, commit_pc=0x000c, rd=7, rd_wdata=0x0000000000000003
//   [4] commit_instr=0x00331833, commit_pc=0x0010, rd=8, rd_wdata=0x0000000000000003
//   [5] commit_instr=0x00000073, commit_pc=0x0014, exception_valid=1, mcause=0x0b
// =============================================================================

// Instruction memory initialization (32-bit words)
00100113    // 0x0000: addi x2, x0, 1
00200193    // 0x0004: addi x3, x0, 2
00331333    // 0x0008: and x6, x2, x3
00331733    // 0x000c: or x7, x2, x3
00331833    // 0x0010: xor x8, x2, x3
00000073    // 0x0014: ecall (trap)
ff9ff06f    // 0x0018: j 0x0000 (jump back, hang loop)
