// =============================================================================
// prog_fencei.hex — TC 2.x Machine Code (FENCE.I for ICache Coherency)
// =============================================================================
// Format: Verilog $readmemh (32-bit words)
//
// NOTE: Two memory regions:
//   Region 1: 0x0000-0x0040 (boot code)
//   Region 2: 0x1000-0x100C (dynamically written code)
//
// Assembly → Machine Code:
//   PC    | Instruction              | Machine Code | Notes
//   ─────────────────────────────────────────────────────────────────
//   0x00  | addi x2, x0, 1           | 0x00100113   | x2 := 1
//   0x04  | lui x3, 0x1              | 0x00001B7   | x3[31:12] := 0x1
//   0x08  | addi x3, x3, 0           | 0x00018193  | x3 := 0x1000
//   0x0C  | lui x4, 0x20             | 0x00020237  | x4[31:12] := 0x20 (instr opcode upper)
//   0x10  | addi x4, x4, 0x293       | 0x29320213  | x4 := 0x00200293 (full addi opcode)
//   0x14  | sw x4, 0(x3)             | 0x00232023  | Store x4 to addr 0x1000
//   0x18  | fence.i                  | 0x0000100F  | Flush ICache
//   0x1C  | jalr x0, x3, 0           | 0x00018067  | Jump to x3 (0x1000)
//   0x20  | j -8 (0x00)              | 0xFD9FF06F  | Hang (unreachable)
//
//   [At 0x1000 - dynamically written by sw at 0x14]
//   0x1000| addi x5, x0, 2           | 0x00200293  | x5 := 2 (self-mod code)
//   0x1004| ecall                    | 0x00000073  | Trap: mcause=11
//   0x1008| j -4 (0x1000)            | 0xFFDFF06F  | Hang
//
// Control flow:
//   1. Boot code (0x00-0x20): Setup, store modified instruction to 0x1000
//   2. FENCE.I: Flush ICache
//   3. JALR x0, x3, 0: Jump to 0x1000
//   4. Execute dynamic code: addi x5, x0, 2
//   5. ECALL: Trap
//
// RVFI Trace (expected):
//   [0] addi x2, x0, 1        → x2=1
//   [1] lui x3, 0x1           → x3=0x1000
//   [2] addi x3, x3, 0        → x3=0x1000 (no change)
//   [3] lui x4, 0x20          → x4=0x20000 (upper immediate loaded)
//   [4] addi x4, x4, 0x293    → x4=0x00200293
//   [5] sw x4, 0(x3)          → Memory[0x1000] = 0x00200293
//   [6] fence.i               → ICache flushed
//   [7] jalr x0, x3, 0        → Jump to 0x1000
//   [8] addi x5, x0, 2        → x5=2 (at 0x1000, from dynamic code)
//   [9] ecall                 → Exception: mcause=11
//
// Verification points (ICache-specific):
//   ✓ FENCE.I instruction commits
//   ✓ After FENCE.I, core refetches from 0x1000
//   ✓ Dynamic code (addi x5, x0, 2) executes correctly
//   ✓ x5 register shows correct value (2)
//   ✓ No instruction cache coherency error
// =============================================================================

// Boot code region: 0x0000-0x0020
00100113    // 0x00: addi x2, x0, 1
000010b7    // 0x04: lui x3, 0x1
00018193    // 0x08: addi x3, x3, 0
00020237    // 0x0c: lui x4, 0x20
29320213    // 0x10: addi x4, x4, 0x293
00232023    // 0x14: sw x4, 0(x3)
0000100f    // 0x18: fence.i
00018067    // 0x1c: jalr x0, x3, 0
fd9ff06f    // 0x20: j -8 (hang)

// Padding to 0x1000 (not typically needed for simulation, but shown for clarity)
// (Host should skip to 0x1000 or fill with 0x00000000 / 0x00000013 NOPs)

// Dynamic code region: 0x1000-0x100C (written by sw at 0x14)
// 0x1000
00200293    // addi x5, x0, 2 (this is what gets stored at 0x1000)
00000073    // ecall
ffeff06f    // j -1 (hang)
