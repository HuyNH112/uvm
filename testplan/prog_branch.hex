// =============================================================================
// prog_branch.hex — TC 1.2 Machine Code (RV64I Branch Instructions)
// =============================================================================
// Format: Verilog $readmemh (32-bit words)
//
// Assembly → Machine Code:
//   PC    | Instruction           | Machine Code | Notes
//   ──────────────────────────────────────────────────────────────────
//   0x00  | addi x2, x0, 1        | 0x00100113   | x2 := 1
//   0x04  | addi x3, x0, 1        | 0x00100193   | x3 := 1
//   0x08  | beq x2, x3, +12 (0x14)| 0x00310663   | Jump if x2==x3 (TAKEN)
//   0x0C  | addi x4, x0, 999      | 0x3E700213   | SKIPPED (beq taken)
//   0x10  | addi x4, x0, 10       | 0x00A00213   | x4 := 10
//   0x14  | addi x5, x0, 20       | 0x01400293   | x5 := 20
//   0x18  | bne x4, x5, +8 (0x20) | 0x00529463   | Jump if x4!=x5 (TAKEN)
//   0x1C  | addi x6, x0, 999      | 0x3E700313   | SKIPPED (bne taken)
//   0x20  | jal x1, +8 (0x28)     | 0x0080006F   | Link PC+4 to x1, jump to 0x28
//   0x24  | addi x0, x0, 0        | 0x00000013   | NOP (placeholder, not reached)
//   0x28  | addi x6, x0, 100      | 0x06400313   | x6 := 100
//   0x2C  | jalr x0, x1, 0        | 0x00008067   | Jump to x1, return point at 0x24
//   0x30  | ecall                 | 0x00000073   | Trap
//   0x34  | j -13 (0x00)          | 0xFD9FF06F   | Jump back to start (hang)
//
// Control flow:
//   0x00-0x04: Setup (x2=1, x3=1)
//   0x08: BEQ TAKEN → Jump to 0x14
//   0x14-0x18: Continue (x4=10, x5=20)
//   0x18: BNE TAKEN → Jump to 0x20
//   0x20: JAL → Link 0x24 to x1, jump to 0x28
//   0x28: Execute, then JALR → Return to 0x24
//   0x24: ECALL → Trap
// =============================================================================

00100113    // 0x00: addi x2, x0, 1
00100193    // 0x04: addi x3, x0, 1
00310663    // 0x08: beq x2, x3, +12 (branch TAKEN)
3e700213    // 0x0c: addi x4, x0, 999 (SKIPPED)
00a00213    // 0x10: addi x4, x0, 10
01400293    // 0x14: addi x5, x0, 20
00529463    // 0x18: bne x4, x5, +8 (branch TAKEN)
3e700313    // 0x1c: addi x6, x0, 999 (SKIPPED)
0080006f    // 0x20: jal x1, +8
00000013    // 0x24: nop (link target, not reached via fall-through)
06400313    // 0x28: addi x6, x0, 100
00008067    // 0x2c: jalr x0, x1, 0 (return to 0x24)
00000073    // 0x30: ecall (trap)
fd9ff06f    // 0x34: j -13 (jump back to 0x00, hang)
